<Window x:Class="PclVersionBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="原版直达 · VanillaReach（PCL 非官方安装助手）" Width="700" Height="740"
        MinWidth="560" MinHeight="580" WindowStartupLocation="CenterScreen"
        Background="#F5F7FB" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="IdleControl" TargetType="Control">
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17263C" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
            <TextBlock Text="原版直达" FontSize="26" FontWeight="SemiBold"
                       Foreground="#17263C" />
            <TextBlock Text="原版装好，PCL 照用。选择目录和版本，安装完成后回到 PCL。"
                       FontSize="14" Foreground="#44556D" Margin="0,8,0,3" TextWrapping="Wrap" />
            <TextBlock Text="非 PCL、Mojang 或 Microsoft 官方工具；仅支持原版正式版。"
                       FontSize="12" Foreground="#596B82" Margin="0,0,0,20" TextWrapping="Wrap" />

            <Border Background="White" BorderBrush="#DDE4EE" BorderThickness="1"
                    CornerRadius="10" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="1 选择游戏目录" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="请选择 PCL 正在使用的 .minecraft 文件夹。建议路径仅供参考，必须由你确认。"
                               FontSize="13" Foreground="#44556D" Margin="0,9,0,12" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource IdleControl}" Height="36" Padding="8,6"
                                 VerticalContentAlignment="Center" AutomationProperties.Name="游戏目录" />
                        <Button Grid.Column="1" Content="浏览…" Click="Browse_Click" Margin="10,0,0,0"
                                Style="{StaticResource IdleControl}" AutomationProperties.Name="浏览游戏目录" />
                    </Grid>
                    <Button Content="确认此目录" Click="ConfirmDirectory_Click" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Padding="16,7" Style="{StaticResource IdleControl}" />
                    <TextBlock Text="确认后若修改路径，需要重新确认。不会修改其他版本、存档或配置。"
                               FontSize="12" Foreground="#596B82" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#DDE4EE" BorderThickness="1"
                    CornerRadius="10" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="2 选择原版正式版" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="搜索版本号（例如 1.20.1；留空显示全部）"
                               FontSize="13" Foreground="#44556D" Margin="0,9,0,0" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,7,0,0" Height="36" Padding="8,6"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource IdleControl}"
                             AutomationProperties.Name="搜索版本号"
                             ToolTip="输入版本号筛选历史正式版；留空显示全部" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding FilteredVersions}"
                                  SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                  DisplayMemberPath="Id" Height="36" Padding="6,4"
                                  Style="{StaticResource IdleControl}" AutomationProperties.Name="原版版本" />
                        <Button Grid.Column="1" Content="刷新" Click="Refresh_Click" Margin="10,0,0,0"
                                Style="{StaticResource IdleControl}" AutomationProperties.Name="刷新版本列表" />
                    </Grid>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE4EE"
                BorderThickness="0,1,0,0" Padding="20,14">
            <StackPanel>
                <TextBlock Text="{Binding Status}" FontSize="14" Foreground="#17263C"
                           TextWrapping="Wrap" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                             Height="8" Margin="0,10,0,0" AutomationProperties.Name="安装进度" />
                <TextBlock Text="{Binding Error}" Foreground="#B42318" FontSize="13"
                           Margin="0,8,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="取消" Click="Cancel_Click" IsEnabled="{Binding IsInstalling}"
                            Width="86" Height="38" Margin="0,0,10,0" />
                    <Button Content="开始安装" Click="Install_Click" IsEnabled="{Binding CanInstall}"
                            Width="118" Height="38" Background="#245FD6" Foreground="White"
                            BorderBrush="#245FD6" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
