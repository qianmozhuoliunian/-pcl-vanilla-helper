<Window x:Class="PclVersionBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PclVersionBridge.App"
        xmlns:friends="clr-namespace:PclVersionBridge.App.Friends"
        Title="原版直达 · VanillaReach（PCL 非官方安装助手）" Width="1000" Height="800"
        MinWidth="760" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}" FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource TextPrimary}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{StaticResource AppBackground}" TextOptions.TextFormattingMode="Display">
        <Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0">
            <Grid Margin="14,28,14,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="10,0,0,32">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Path Data="M 10 9 L 20 4 L 30 9 L 30 22 L 20 28 L 10 22 Z M 10 9 L 20 15 L 30 9 M 20 15 L 20 28" Stroke="White" StrokeThickness="1.5" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="原版直达" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="VanillaReach" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="功能" Style="{StaticResource Hint}" Margin="12,0,0,8"/>
                    <ListBox x:Name="Navigation" SelectedIndex="{Binding SelectedIndex, ElementName=Pages, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource NavigationItem}" AutomationProperties.Name="功能导航">
                        <ListBoxItem AutomationProperties.Name="原版安装">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8 1 L 8 11 M 4 7 L 8 11 L 12 7 M 1 12 L 1 16 L 15 16 L 15 12" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform"/>
                                <TextBlock Text="原版安装" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="整合包">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 1 5 L 9 1 L 17 5 L 17 14 L 9 18 L 1 14 Z M 1 5 L 9 9 L 17 5 M 9 9 L 9 18" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.4" Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform"/>
                                <TextBlock Text="整合包" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="好友">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 11 5 A 3 3 0 1 1 5 5 A 3 3 0 1 1 11 5 M 2 17 L 2 15 C 2 10 14 10 14 15 L 14 17 M 14 3 C 19 3 19 9 15 9 M 16 12 C 19 12 20 14 20 17" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.4" Width="20" Height="18" Margin="0,0,8,0" Stretch="Uniform"/>
                                <TextBlock Text="好友" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="8,16,4,0">
                    <TextBlock Text="原版装好，&#10;PCL 照用。" FontSize="13" Foreground="{StaticResource TextSecondary}" LineHeight="21" Margin="0,0,0,14"/>
                    <Border Background="{StaticResource Surface}" CornerRadius="6" Padding="7,5" HorizontalAlignment="Left">
                        <TextBlock Text="非官方 · 技术预览" Style="{StaticResource Hint}" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="24,24,24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,22">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
                            <Setter Property="Text" Value="原版安装"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex,ElementName=Pages}" Value="1"><Setter Property="Text" Value="探索整合包"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex,ElementName=Pages}" Value="2"><Setter Property="Text" Value="和朋友一起装"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Style="{StaticResource Hint}" Text="安装、探索、分享。完成后，回到熟悉的 PCL。" Margin="0,6,0,0"/>
            </StackPanel>
            <Border x:Name="DirectoryCard" Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="16" Margin="0,0,0,16">
                <StackPanel x:Name="DirectoryPanel" Style="{StaticResource IdleForm}">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="游戏目录" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="12">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="选择 PCL 使用的 .minecraft"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding DirectoryConfirmed}" Value="True"><Setter Property="Text" Value="目录已确认"/><Setter Property="Foreground" Value="{StaticResource SuccessText}"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="游戏目录" ToolTip="请选择 PCL 使用的 .minecraft 文件夹"/>
                        <Button Grid.Column="1" Content="浏览…" Click="Browse_Click" Margin="8,0,0,0" AutomationProperties.Name="浏览游戏目录" Style="{StaticResource QuietButton}"/>
                        <Button Grid.Column="2" Content="确认目录" Click="ConfirmDirectory_Click" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="修改路径后需重新确认；已有版本与存档不会被覆盖。" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <TabControl x:Name="Pages" Grid.Row="2" SelectedIndex="0" SelectionChanged="Pages_SelectionChanged" Style="{StaticResource PageHost}">
                <TabItem Header="原版安装">
                    <Border Style="{StaticResource SurfaceCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="24" Style="{StaticResource IdleForm}">
                                    <TextBlock Text="选择原版正式版" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="从官方来源获取游戏文件，安装到你确认的目录。" Style="{StaticResource Hint}" Margin="0,8,0,24"/>
                                    <TextBlock Text="筛选版本号" Margin="0,0,0,8" FontWeight="Medium"/>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索版本号" ToolTip="例如 1.20.1；留空显示全部正式版"/>
                                    <TextBlock Text="原版正式版" Margin="0,20,0,8" FontWeight="Medium"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding FilteredVersions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" DisplayMemberPath="Id" AutomationProperties.Name="原版版本"/>
                                        <Button Grid.Column="1" Content="刷新" Click="Refresh_Click" Margin="8,0,0,0" AutomationProperties.Name="刷新版本列表" Style="{StaticResource QuietButton}"/>
                                    </Grid>
                                    <Border Background="{StaticResource SurfaceInset}" CornerRadius="10" Padding="14,12" Margin="0,24,0,0">
                                        <TextBlock Text="安装之后，回到 PCL 选择版本。账号、Java 和游戏启动继续由 PCL 管理。" Style="{StaticResource Hint}"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="VanillaFooter" Grid.Row="1" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Status}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="5" Margin="0,10,0,0" AutomationProperties.Name="安装进度"/>
                                    <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="取消" Click="Cancel_Click" IsEnabled="{Binding IsInstalling}" MinWidth="72" Margin="0,0,8,0" Style="{StaticResource QuietButton}"/>
                                        <Button Content="开始安装" Click="Install_Click" IsEnabled="{Binding CanInstall}" MinWidth="120" Style="{StaticResource PrimaryButton}" ToolTip="请先确认目录并选择原版正式版"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="整合包"><local:ModpackView x:Name="PackPage"/></TabItem>
                <TabItem Header="好友"><friends:FriendsView x:Name="FriendsPage"/></TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
