<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PclVersionBridge.Core\PclVersionBridge.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VanillaReach</AssemblyName>
    <Product>原版直达 · VanillaReach</Product>
    <Title>VanillaReach</Title>
    <Description>面向 PCL 玩家的非官方 Minecraft Java 原版安装助手</Description>
    <Copyright>Copyright (c) 2026 VanillaReach contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\LICENSE;..\..\THIRD-PARTY-NOTICES.md;..\..\PRIVACY.md;..\..\QUICKSTART.txt"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\licenses\**\*"
             Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="..\..\docs\dependencies.md" Link="docs\dependencies.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
